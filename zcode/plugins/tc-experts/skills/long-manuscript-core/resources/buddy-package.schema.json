{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fbs.buddy-package/v1",
  "title": "FBSir Buddy Package",
  "type": "object",
  "required": ["schemaVersion", "packageId", "version", "displayName", "scenarios", "policies", "evaluators"],
  "properties": {
    "schemaVersion": {"const": "fbs.buddy-package/v1"},
    "packageId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "minLength": 1},
    "displayName": {"type": "object", "required": ["zh", "en"], "additionalProperties": false, "properties": {"zh": {"type": "string"}, "en": {"type": "string"}}},
    "scenarios": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "templates": {"type": "array", "items": {"type": "string"}},
    "policies": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evaluators": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "adapters": {"type": "array", "items": {"type": "string"}},
    "brand": {"type": ["string", "null"]},
    "minimumWorkbuddyVersion": {"type": ["string", "null"]},
    "targetWorkbuddyVersion": {"type": ["string", "null"]},
    "platformMappingState": {"enum": ["proposal_only_not_open_platform_uploaded", "locally_previewed", "platform_draft", "platform_reviewed"]},
    "openPlatformMapping": {"type": "string", "pattern": "^[^/\\\\]+\\.json$"},
    "connectorRequired": {"const": false},
    "coreOverride": {"const": false}
  },
  "additionalProperties": false
}
