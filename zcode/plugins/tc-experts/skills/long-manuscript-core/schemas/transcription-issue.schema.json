{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://u3w.com/schemas/manuscriptos/transcription-issue.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "issueId", "page", "line", "anchor", "token", "category", "candidates", "decision", "decisionBasis", "sourceRef", "sourceCrop", "state", "hostMutationAllowed", "issueDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "artifactType": { "const": "manuscriptos_transcription_issue" }, "issueId": { "type": "string", "minLength": 1 }, "page": { "type": "integer", "minimum": 1 }, "line": { "type": ["integer", "null"], "minimum": 1 },
    "anchor": { "type": "string" }, "token": { "type": "string" }, "category": { "enum": ["definite_encoding_error", "probable_ocr_fragment", "rare_term_candidate", "source_print_variant", "numeric_unit_conflict", "source_conflict", "cross_page_boundary"] },
    "candidates": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "decision": { "type": ["string", "null"] }, "decisionBasis": { "type": ["string", "null"] }, "sourceRef": { "type": ["string", "null"] },
    "sourceCrop": { "oneOf": [{ "type": "null" }, { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0 } }] }, "state": { "enum": ["open", "resolved", "waived"] }, "hostMutationAllowed": { "const": false }, "issueDigest": { "$ref": "#/$defs/sha256" }
  }, "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
