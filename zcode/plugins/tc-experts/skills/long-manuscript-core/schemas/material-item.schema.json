{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/material-item.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "source", "rightsStatus", "privacyClass", "contentDigest", "extractionState"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["text", "markdown", "document", "office", "table", "pdf", "image", "audio", "video", "web", "transcript", "other"] },
    "materialRole": { "enum": ["content", "reference_style", "both_scoped", "control_instruction"] },
    "useScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factUse", "styleUse", "instructionUse", "scopeRefs"],
      "properties": {
        "factUse": { "enum": ["allowed", "forbidden"] },
        "styleUse": { "enum": ["allowed", "forbidden"] },
        "instructionUse": { "enum": ["allowed", "forbidden"] },
        "scopeRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "name": { "type": ["string", "null"] },
    "source": { "type": ["string", "null"] },
    "rightsStatus": { "enum": ["cleared", "unknown", "restricted"] },
    "privacyClass": { "enum": ["public", "internal", "private", "restricted"] },
    "contentDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "contentRef": { "type": ["string", "null"], "maxLength": 4096 },
    "declaredBytes": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "inventoryState": { "enum": ["metadata_observed", "hash_pending", "hash_complete"] },
    "hashMode": { "enum": ["metadata_only", "streaming", "incremental", "complete"] },
    "maturityLevel": { "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
    "extractionState": { "enum": ["descriptor_ready", "extracted", "observed", "partial", "not_observed", "degraded", "unsupported", "human_review_pending"] }
  }
}
