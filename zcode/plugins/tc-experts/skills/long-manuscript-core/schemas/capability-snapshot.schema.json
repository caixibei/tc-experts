{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/capability-snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "taskId", "requiredCapabilities", "optionalCapabilities", "availableCapabilities", "rejectionSignals", "allowedDegradations", "missingRequired", "missingOptional", "activeDegradations", "claimsAllowed", "cannotClaim", "status", "hostMutationAllowed", "externalActionCount", "snapshotDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactType": { "const": "manuscriptos_capability_snapshot" },
    "taskId": { "type": "string", "minLength": 1 },
    "requiredCapabilities": { "$ref": "#/$defs/stringSet" },
    "optionalCapabilities": { "$ref": "#/$defs/stringSet" },
    "availableCapabilities": { "$ref": "#/$defs/stringSet" },
    "rejectionSignals": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["capability", "signal", "source"], "properties": { "capability": { "type": "string", "minLength": 1 }, "signal": { "type": "string", "minLength": 1 }, "source": { "type": "string", "minLength": 1 } } } },
    "allowedDegradations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["capability", "fallback", "acceptedByUser"], "properties": { "capability": { "type": "string", "minLength": 1 }, "fallback": { "type": "string", "minLength": 1 }, "acceptedByUser": { "type": "boolean" } } } },
    "missingRequired": { "$ref": "#/$defs/stringSet" },
    "missingOptional": { "$ref": "#/$defs/stringSet" },
    "activeDegradations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["capability", "fallback"], "properties": { "capability": { "type": "string", "minLength": 1 }, "fallback": { "type": "string", "minLength": 1 } } } },
    "claimsAllowed": { "$ref": "#/$defs/stringSet" },
    "cannotClaim": { "$ref": "#/$defs/stringSet" },
    "status": { "enum": ["ready", "degraded", "blocked"] },
    "hostMutationAllowed": { "const": false },
    "externalActionCount": { "const": 0 },
    "snapshotDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stringSet": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
