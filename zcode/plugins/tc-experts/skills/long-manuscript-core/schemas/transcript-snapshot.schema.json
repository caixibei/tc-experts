{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/transcript-snapshot.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "snapshotId", "layer", "immutable", "sourceManifestDigest", "binding", "ocrObservationDigests", "supersedesSnapshotIds", "observedPageOrder", "pages", "hostMutationAllowed", "observedAt", "snapshotDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "artifactType": { "const": "manuscriptos_transcript_snapshot" }, "snapshotId": { "type": "string", "minLength": 1 },
    "layer": { "enum": ["ocr_raw", "reviewed", "delivery"] }, "immutable": { "const": true }, "sourceManifestDigest": { "$ref": "#/$defs/sha256" },
    "binding": { "type": "object", "additionalProperties": false, "required": ["ref", "declaredByteLength", "suppliedSha256", "evidenceClass", "version", "current"], "properties": { "ref": { "type": ["string", "null"] }, "declaredByteLength": { "type": "integer", "minimum": 0 }, "suppliedSha256": { "$ref": "#/$defs/sha256" }, "evidenceClass": { "enum": ["in_memory_content_observed", "digest_supplied_not_observed", "descriptor_only"] }, "version": { "type": ["string", "null"] }, "current": { "type": "boolean" } } },
    "ocrObservationDigests": { "$ref": "#/$defs/digests" }, "supersedesSnapshotIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "observedPageOrder": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } }, "hostMutationAllowed": { "const": false },
    "observedAt": { "type": ["string", "null"] }, "snapshotDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "digests": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
    "boundary": { "type": "object", "additionalProperties": false, "required": ["linePolicy", "continuesFromPrevious", "continuesToNext", "continuationToken"], "properties": { "linePolicy": { "enum": ["preserve_source_lines", "paragraphized", "unknown"] }, "continuesFromPrevious": { "type": "boolean" }, "continuesToNext": { "type": "boolean" }, "continuationToken": { "type": ["string", "null"] } } },
    "page": { "type": "object", "additionalProperties": false, "required": ["page", "text", "textSha256", "reviewState", "boundary"], "properties": { "page": { "type": "integer", "minimum": 1 }, "text": { "type": "string" }, "textSha256": { "$ref": "#/$defs/sha256" }, "reviewState": { "enum": ["ocr_extracted_unreviewed", "reviewed", "source_verified"] }, "boundary": { "$ref": "#/$defs/boundary" } } }
  }
}
