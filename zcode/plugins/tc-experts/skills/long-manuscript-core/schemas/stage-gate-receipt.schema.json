{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fbs.stage-gate-receipt/v1",
  "title": "Physical Stage Gate Receipt",
  "type": "object",
  "required": ["schemaVersion", "receiptId", "gateId", "status", "projectId", "inputDigest", "issuedAt", "currentReceipt", "receiptDigestAlgorithm", "receiptDigest"],
  "properties": {
    "schemaVersion": {"const": "fbs.stage-gate-receipt/v1"},
    "receiptId": {"type": "string", "minLength": 1},
    "gateId": {"type": "string", "minLength": 1},
    "status": {"const": "passed"},
    "projectId": {"type": "string", "minLength": 1},
    "inputDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": ["string", "null"], "format": "date-time"},
    "currentReceipt": {"const": true},
    "receiptDigestAlgorithm": {"const": "sha256_canonical_json_without_receipt_digest_v1"},
    "receiptDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
