{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/artifact-provenance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "artifactId", "contentDigest", "observationState", "derivationKind", "sourceRefs", "inferenceRefs", "parentArtifactDigests", "crossValidation", "generatedByCapability", "evidenceState", "confidence", "claimBoundary", "contentReadClaimAllowed", "externalActionCount", "provenanceDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactType": { "const": "manuscriptos_artifact_provenance" },
    "artifactId": { "type": "string", "minLength": 1 },
    "contentDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "observationState": { "enum": ["bytes_observed", "summary_observed", "digest_supplied_not_observed", "descriptor_only"] },
    "derivationKind": { "enum": ["source_bound", "inference", "mixed"] },
    "sourceRefs": { "$ref": "#/$defs/stringSet" },
    "inferenceRefs": { "$ref": "#/$defs/stringSet" },
    "parentArtifactDigests": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
    "crossValidation": { "enum": ["none", "single", "double", "triple"] },
    "generatedByCapability": { "type": "string", "minLength": 1 },
    "evidenceState": { "enum": ["source_observed", "summary_only", "digest_bound_not_observed", "advisory"] },
    "confidence": { "enum": ["unknown", "low", "medium", "high"] },
    "claimBoundary": { "type": "string", "minLength": 1 },
    "contentReadClaimAllowed": { "type": "boolean" },
    "externalActionCount": { "const": 0 },
    "provenanceDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stringSet": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
