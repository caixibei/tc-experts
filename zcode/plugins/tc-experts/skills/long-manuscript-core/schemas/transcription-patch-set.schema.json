{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://u3w.com/schemas/manuscriptos/transcription-patch-set.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "snapshotDigest", "patches", "status", "issues", "hostMutationAllowed", "patchSetDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "artifactType": { "const": "manuscriptos_transcription_patch_set" }, "snapshotDigest": { "$ref": "#/$defs/sha256" },
    "patches": { "type": "array", "items": { "$ref": "#/$defs/patch" } }, "status": { "enum": ["ready", "rejected"] }, "issues": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "hostMutationAllowed": { "const": false }, "patchSetDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "patch": { "type": "object", "additionalProperties": false, "required": ["patchId", "page", "from", "to", "expectedOccurrences", "pagePreimageSha256", "pagePostimageSha256", "sourceAnchor", "reason"], "properties": { "patchId": { "type": "string", "minLength": 1 }, "page": { "type": "integer", "minimum": 1 }, "from": { "type": "string", "minLength": 1 }, "to": { "type": "string" }, "expectedOccurrences": { "type": "integer", "minimum": 1 }, "pagePreimageSha256": { "$ref": "#/$defs/sha256" }, "pagePostimageSha256": { "$ref": "#/$defs/sha256" }, "sourceAnchor": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } } }
  }
}
