{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/transcription-sample-validation.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "manifestDigest", "requiredCategories", "samples", "missingCategories", "hostMutationAllowed", "status", "issues", "validationDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "artifactType": { "const": "manuscriptos_transcription_sample_validation" }, "manifestDigest": { "$ref": "#/$defs/sha256" },
    "requiredCategories": { "$ref": "#/$defs/categories" }, "samples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sample" } }, "missingCategories": { "$ref": "#/$defs/categories" },
    "hostMutationAllowed": { "const": false }, "status": { "enum": ["ready", "needs_input"] }, "issues": { "$ref": "#/$defs/issues" }, "validationDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "issues": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "categories": { "type": "array", "uniqueItems": true, "items": { "enum": ["sparse", "dense", "layout_risk", "cross_page_boundary"] } },
    "sample": { "type": "object", "additionalProperties": false, "required": ["page", "category", "sourceRef", "snapshotDigest", "reviewedAgainstSource", "reviewerEvidenceClass", "issues"], "properties": { "page": { "type": "integer", "minimum": 1 }, "category": { "enum": ["sparse", "dense", "layout_risk", "cross_page_boundary"] }, "sourceRef": { "type": "string", "minLength": 1 }, "snapshotDigest": { "$ref": "#/$defs/sha256" }, "reviewedAgainstSource": { "type": "boolean" }, "reviewerEvidenceClass": { "const": "human_attestation_supplied" }, "issues": { "$ref": "#/$defs/issues" } } }
  }
}
