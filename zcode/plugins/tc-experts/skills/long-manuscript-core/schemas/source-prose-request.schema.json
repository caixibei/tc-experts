{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source to prose structural binding request",
  "type": "object",
  "required": ["schemaVersion", "facts", "segments"],
  "properties": {
    "schemaVersion": { "const": "manuscriptos.source-prose-request/v1" },
    "maxCharacters": { "type": "integer", "minimum": 1 },
    "facts": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "required": ["id", "value", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "value": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "type": { "enum": ["token", "date", "quote", "quantity"] },
          "temporalRole": { "enum": ["event", "document", "record"] },
          "sourceRef": { "type": "string", "minLength": 1 },
          "sourceDigest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "reviewState": { "type": "string" },
          "unknowns": { "type": "array", "items": { "type": "string" } },
          "reviewBasis": {
            "type": "object", "required": ["kind", "reference"],
            "properties": { "kind": { "enum": ["source_reread", "user_confirmed"] }, "reference": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "segments": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "required": ["kind", "text", "factRefs"],
        "properties": {
          "kind": { "enum": ["fact", "inference", "example", "unknown", "editorial"] },
          "text": { "type": "string", "maxLength": 4096 },
          "factRefs": { "type": "array", "maxItems": 256, "items": { "type": "string" } },
          "temporalRole": { "enum": ["event", "document", "record"] }
        }
      }
    }
  },
  "$comment": "Runtime additionally checks source review, point-of-use labels, date roles, exact values, refs and character count. A pass is not proof of source truth."
}
