{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://u3w.com/schemas/manuscriptos/source-fidelity-status.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "mode", "lifecycleState", "manifestDigest", "snapshotDigest", "rawSnapshotDigest", "sampleValidationDigest", "deliverySnapshotDigest", "patchProofCount", "evidenceState", "dimensions", "gates", "issues", "ocrExecutionPerformed", "hostMutationAllowed", "externalActionCount", "statusDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "artifactType": { "const": "manuscriptos_source_fidelity_status" },
    "mode": { "type": "object", "additionalProperties": false, "required": ["operationMode", "reviewSubmode"], "properties": { "operationMode": { "enum": ["source_transcription", "review_quality"] }, "reviewSubmode": { "enum": ["transcription_comparison", null] } } },
    "lifecycleState": { "enum": ["intake", "page_mapped", "sample_validated", "extracted", "reconciled", "quality_gate_required", "human_review_pending", "delivery_ready"] },
    "manifestDigest": { "$ref": "#/$defs/sha256" }, "snapshotDigest": { "$ref": "#/$defs/sha256" }, "rawSnapshotDigest": { "$ref": "#/$defs/nullableSha" }, "sampleValidationDigest": { "$ref": "#/$defs/nullableSha" }, "deliverySnapshotDigest": { "$ref": "#/$defs/nullableSha" },
    "patchProofCount": { "type": "integer", "minimum": 0 }, "evidenceState": { "enum": ["advisory", "human_review_pending", "machine_receipt_present"] },
    "dimensions": { "type": "object", "additionalProperties": false, "required": ["coverage", "ordering", "orientation", "rawEvidence", "sampleValidation", "extraction", "reconciliation", "humanReview", "delivery"], "properties": { "coverage": { "enum": ["verified", "failed"] }, "ordering": { "enum": ["verified", "failed"] }, "orientation": { "enum": ["verified", "failed"] }, "rawEvidence": { "enum": ["verified", "missing", "not_required"] }, "sampleValidation": { "enum": ["verified", "missing", "not_required"] }, "extraction": { "enum": ["supplied_observation_receipt_present", "not_run"] }, "reconciliation": { "enum": ["complete", "partial", "not_run"] }, "humanReview": { "enum": ["pending", "not_required"] }, "delivery": { "enum": ["ready_for_host_delivery", "blocked", "not_applicable"] } } },
    "gates": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/gate" } }, "issues": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "ocrExecutionPerformed": { "const": false }, "hostMutationAllowed": { "const": false }, "externalActionCount": { "const": 0 }, "statusDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "nullableSha": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "gate": { "type": "object", "additionalProperties": false, "required": ["gateId", "status", "issues", "receiptDigest"], "properties": { "gateId": { "enum": ["page-sequence.integrity", "transcription.fidelity", "ocr-artifact.suspect"] }, "status": { "enum": ["passed", "failed", "human_review_pending"] }, "issues": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "receiptDigest": { "$ref": "#/$defs/sha256" } } }
  }
}
