{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/chapter-checkpoint.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "checkpointId", "checkpointIndex", "projectStateDigest", "chapterId", "previousCheckpointDigest", "previousStatus", "status", "contentDigest", "measuredWordCount", "targetWordCount", "sourceProvenanceDigest", "nextObjective", "issues", "externalActionCount", "checkpointDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactType": { "const": "manuscriptos_chapter_checkpoint" },
    "checkpointId": { "type": "string", "minLength": 1 },
    "checkpointIndex": { "type": "integer", "minimum": 1 },
    "projectStateDigest": { "$ref": "#/$defs/sha256" },
    "chapterId": { "type": "string", "minLength": 1 },
    "previousCheckpointDigest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "previousStatus": { "enum": ["planned", "drafting", "reviewing", "complete", "blocked", null] },
    "status": { "enum": ["planned", "drafting", "reviewing", "complete", "blocked"] },
    "contentDigest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "measuredWordCount": { "type": "integer", "minimum": 0 },
    "targetWordCount": { "type": ["integer", "null"], "minimum": 1 },
    "sourceProvenanceDigest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "nextObjective": { "type": ["string", "null"] },
    "issues": { "$ref": "#/$defs/stringSet" },
    "externalActionCount": { "const": 0 },
    "checkpointDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stringSet": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
