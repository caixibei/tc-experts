{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fbs.modality-receipt/v1",
  "title": "Multimodal observation receipt",
  "type": "object",
  "required": ["modality", "sourceArtifactId", "inputDigest", "processor", "observedRange", "status"],
  "properties": {
    "modality": {"enum": ["text", "pdf", "image", "table", "office", "audio", "video", "web"]},
    "sourceArtifactId": {"type": "string", "minLength": 1},
    "inputDigest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "processor": {"type": "string", "minLength": 1},
    "observedRange": {"type": "object", "additionalProperties": true},
    "observationDigest": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
    "evidenceLayer": {"enum": ["model_declaration", "attachment_presentation", "content_observation", "expert_use"]},
    "originalReadOnly": {"type": "boolean"},
    "hostProduct": {"enum": ["WorkBuddy", null]},
    "contentRef": {"type": ["string", "null"], "maxLength": 4096},
    "declaredBytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "coveredBytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "residualBytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "maturityLevel": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5"]},
    "inventoryState": {"enum": ["metadata_observed", "hash_pending", "hash_complete"]},
    "derivedArtifactIds": {"type": "array", "items": {"type": "string"}},
    "confidence": {
      "type": "object",
      "properties": {
        "extraction": {"type": "number", "minimum": 0, "maximum": 1},
        "alignment": {"type": "number", "minimum": 0, "maximum": 1},
        "identity": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["observed", "partial", "not_observed", "degraded", "unknown", "unsupported", "failed", "retryable", "human_review_required", "blocked_low_confidence"]},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "humanReviewState": {"enum": ["not_required", "pending", "confirmed", "rejected"]}
  },
  "additionalProperties": false
}
