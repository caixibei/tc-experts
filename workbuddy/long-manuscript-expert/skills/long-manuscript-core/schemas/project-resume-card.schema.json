{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/project-resume-card.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "entryId", "projectId", "documentType", "continuationCapsule", "evidenceBindings", "reconciliation", "firstValue", "evidenceState", "currentMachineReceiptDigests", "connectorRequired", "externalToolsAvailableSemantics", "externalToolAutoTriggered", "optionalPortAutoTriggered", "writesPerformed", "hostGoalClaimed", "officialListingClaimed", "cardDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactType": { "const": "manuscriptos_project_resume_card" },
    "entryId": { "const": "project_resume" },
    "projectId": { "type": "string", "minLength": 1 },
    "documentType": { "type": "string", "minLength": 1 },
    "continuationCapsule": {
      "type": "object", "additionalProperties": false,
      "required": ["provided", "digest", "currentAnchor", "nextObjective", "savedBySystem"],
      "properties": {
        "provided": { "type": "boolean" }, "digest": { "$ref": "#/$defs/nullableSha" }, "currentAnchor": { "type": "string" }, "nextObjective": { "type": "string" }, "savedBySystem": { "const": false }
      }
    },
    "evidenceBindings": {
      "type": "object", "additionalProperties": false,
      "required": ["projectStatusDigest", "chapterCheckpointDigest", "factDeltaDigest", "objectiveBindingDigest"],
      "properties": {
        "projectStatusDigest": { "$ref": "#/$defs/nullableSha" }, "chapterCheckpointDigest": { "$ref": "#/$defs/nullableSha" },
        "factDeltaDigest": { "$ref": "#/$defs/nullableSha" }, "objectiveBindingDigest": { "$ref": "#/$defs/nullableSha" }
      }
    },
    "reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "projectState", "chapterState", "currentAnchor", "nextObjective", "lockedConstraints", "unresolvedFacts", "issues"],
      "properties": {
        "status": { "enum": ["aligned", "capsule_only", "needs_input", "conflict"] }, "projectState": { "type": ["string", "null"] }, "chapterState": { "type": ["string", "null"] },
        "currentAnchor": { "type": "string" }, "nextObjective": { "type": "string" }, "lockedConstraints": { "$ref": "#/$defs/stringSet" }, "unresolvedFacts": { "$ref": "#/$defs/stringSet" }, "issues": { "$ref": "#/$defs/stringSet" }
      }
    },
    "firstValue": {
      "type": "object", "additionalProperties": false,
      "required": ["editableStructure", "substantiveText", "singleNextStep"],
      "properties": {
        "editableStructure": { "type": "object" }, "substantiveText": { "type": "string", "minLength": 1 }, "singleNextStep": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceState": { "enum": ["advisory", "machine_receipt_present", "human_review_pending"] },
    "currentMachineReceiptDigests": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
    "connectorRequired": { "const": false }, "externalToolsAvailableSemantics": { "const": "declaration_only" },
    "externalToolAutoTriggered": { "const": false }, "optionalPortAutoTriggered": { "const": false }, "writesPerformed": { "const": false },
    "hostGoalClaimed": { "const": false }, "officialListingClaimed": { "const": false }, "cardDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "stringSet": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
