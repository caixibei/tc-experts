{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fbs.provenance-anchor/v1",
  "title": "Multimodal Provenance Anchor",
  "type": "object",
  "required": ["artifactId", "modality", "locationType", "location"],
  "properties": {
    "artifactId": {"type": "string", "minLength": 1},
    "modality": {"enum": ["text", "pdf", "image", "table", "office", "audio", "video", "web"]},
    "locationType": {"enum": ["character_range", "page", "page_bbox", "bbox", "cell_range", "paragraph_range", "slide", "time_range", "frame_range", "frame_bbox", "url_section", "descriptor_only"]},
    "location": {"type": "object", "additionalProperties": true},
    "label": {"type": ["string", "null"]},
    "observed": {"type": "boolean"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "contentRef": {"type": ["string", "null"], "maxLength": 4096},
    "contentDigest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "declaredUnits": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "coveredUnits": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "residualUnits": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991}
  },
  "additionalProperties": false
}
