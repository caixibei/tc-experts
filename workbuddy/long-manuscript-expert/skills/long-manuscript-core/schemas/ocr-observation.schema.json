{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/ocr-observation.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "observationId", "page", "immutable", "executionBoundary", "engine", "input", "output", "ocrExecutionPerformed", "hostMutationAllowed", "externalActionCount", "networkUsed", "observedAt", "observationDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "artifactType": { "const": "manuscriptos_ocr_observation" }, "observationId": { "type": "string", "minLength": 1 },
    "page": { "type": "integer", "minimum": 1 }, "immutable": { "const": true }, "executionBoundary": { "const": "supplied_text_only" },
    "engine": { "type": "object", "additionalProperties": false, "required": ["name", "version", "host"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": ["string", "null"] }, "host": { "const": null } } },
    "input": { "type": "object", "additionalProperties": false, "required": ["sourceId", "sourceSha256", "orientation", "preprocessingProfile"], "properties": { "sourceId": { "type": "string", "minLength": 1 }, "sourceSha256": { "$ref": "#/$defs/sha256" }, "orientation": { "enum": [0, 90, 180, 270] }, "preprocessingProfile": { "type": "string", "minLength": 1 } } },
    "output": { "type": "object", "additionalProperties": false, "required": ["rawText", "rawTextSha256", "lines", "errors"], "properties": { "rawText": { "type": "string" }, "rawTextSha256": { "$ref": "#/$defs/sha256" }, "lines": { "type": "array", "items": { "$ref": "#/$defs/line" } }, "errors": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } } },
    "ocrExecutionPerformed": { "const": false }, "hostMutationAllowed": { "const": false }, "externalActionCount": { "const": 0 }, "networkUsed": { "const": false },
    "observedAt": { "type": ["string", "null"] }, "observationDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "line": { "type": "object", "additionalProperties": false, "required": ["index", "text", "bbox"], "properties": { "index": { "type": "integer", "minimum": 1 }, "text": { "type": "string" }, "bbox": { "oneOf": [{ "type": "null" }, { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0 } }] } } }
  }
}
