{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/page-mapping-fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "id", "mappingKind", "expectedPages", "fileCount", "pagesPerFile", "pathTemplate", "rotations", "expectedCoverage"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactType": { "const": "manuscriptos_page_mapping_fixture" },
    "id": { "type": "string", "minLength": 1 },
    "mappingKind": { "enum": ["double_page_spreads", "linear_single_pages"] },
    "expectedPages": { "type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": { "start": { "type": "integer", "minimum": 1 }, "end": { "type": "integer", "minimum": 1 } } },
    "fileCount": { "type": "integer", "minimum": 1 },
    "pagesPerFile": { "enum": [1, 2] },
    "pathTemplate": { "type": "string", "pattern": "\\{frame\\}" },
    "rotations": { "type": "object", "patternProperties": { "^[1-9][0-9]*$": { "enum": [0, 90, 180, 270] } }, "additionalProperties": false },
    "expectedCoverage": { "type": "integer", "minimum": 1 }
  }
}
