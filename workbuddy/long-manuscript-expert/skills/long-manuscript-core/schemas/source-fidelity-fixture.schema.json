{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/source-fidelity-fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "cases"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactType": { "enum": ["v26826_source_fidelity_manifest_fixtures", "v26826_source_fidelity_transcript_fixtures", "v26826_source_fidelity_workflow_fixtures"] },
    "cases": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 }, "expectedStatus": { "type": "string" }, "expectedIssue": { "type": ["string", "null"] } } } }
  }
}
