{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/project-status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "projectId", "projectState", "projectStateDigest", "chapterPlanDigest", "objectiveBindingDigest", "latestCheckpointDigests", "chapterProgress", "words", "gateStates", "objectiveVerdict", "readyForObjectiveCompletion", "issues", "warnings", "writesPerformed", "externalActionCount", "statusDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactType": { "const": "manuscriptos_project_status" },
    "projectId": { "type": "string", "minLength": 1 },
    "projectState": { "enum": ["intake", "planned", "drafting", "reviewing", "delivery_ready", "delivered"] },
    "projectStateDigest": { "$ref": "#/$defs/sha256" },
    "chapterPlanDigest": { "$ref": "#/$defs/sha256" },
    "objectiveBindingDigest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "latestCheckpointDigests": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
    "chapterProgress": { "type": "object", "additionalProperties": false, "required": ["total", "complete", "blocked", "reviewing", "percent"], "properties": { "total": { "type": "integer", "minimum": 0 }, "complete": { "type": "integer", "minimum": 0 }, "blocked": { "type": "integer", "minimum": 0 }, "reviewing": { "type": "integer", "minimum": 0 }, "percent": { "type": "integer", "minimum": 0, "maximum": 100 } } },
    "words": { "type": "object", "additionalProperties": false, "required": ["target", "measured", "deviationPercent"], "properties": { "target": { "type": "integer", "minimum": 0 }, "measured": { "type": "integer", "minimum": 0 }, "deviationPercent": { "type": ["integer", "null"] } } },
    "gateStates": { "type": "object", "additionalProperties": { "enum": ["passed", "failed", "human_review_pending", "not_run", "unknown"] } },
    "objectiveVerdict": { "enum": ["in_progress", "blocked", "state_conflict", "review_required", "complete"] },
    "readyForObjectiveCompletion": { "type": "boolean" },
    "issues": { "$ref": "#/$defs/stringSet" },
    "warnings": { "$ref": "#/$defs/stringSet" },
    "writesPerformed": { "const": false },
    "externalActionCount": { "const": 0 },
    "statusDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stringSet": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
