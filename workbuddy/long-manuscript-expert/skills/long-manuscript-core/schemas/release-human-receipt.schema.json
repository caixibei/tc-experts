{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fbs.release-human-receipt/v1",
  "title": "Release Human Approval Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "projectId", "artifactDigest", "issuedAt", "expiresAt", "currentReceipt", "status", "decision", "humanOwnerRole", "receiptDigestAlgorithm", "receiptDigest"],
  "properties": {
    "schemaVersion": {"const": "fbs.release-human-receipt/v1"},
    "receiptId": {"type": "string", "minLength": 1},
    "projectId": {"type": "string", "minLength": 1},
    "artifactDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "currentReceipt": {"const": true},
    "status": {"const": "approved"},
    "decision": {"const": "approved"},
    "humanOwnerRole": {"type": "string", "minLength": 1},
    "receiptDigestAlgorithm": {"const": "sha256_canonical_json_without_receipt_digest_v1"},
    "receiptDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
