{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u3w.com/schemas/manuscriptos/page-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "expectedPages", "pages", "coverage", "ordering", "evidenceClass", "hostMutationAllowed", "status", "issues", "manifestDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactType": { "const": "manuscriptos_page_manifest" },
    "expectedPages": { "$ref": "#/$defs/pageRange" },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["expectedCount", "presentCount", "missingPages", "duplicatePages", "outOfRangePages"],
      "properties": {
        "expectedCount": { "type": "integer", "minimum": 1 }, "presentCount": { "type": "integer", "minimum": 0 },
        "missingPages": { "$ref": "#/$defs/pages" }, "duplicatePages": { "$ref": "#/$defs/pages" }, "outOfRangePages": { "$ref": "#/$defs/pages" }
      }
    },
    "ordering": {
      "type": "object", "additionalProperties": false, "required": ["observedPages", "monotonic"],
      "properties": { "observedPages": { "$ref": "#/$defs/pages" }, "monotonic": { "type": "boolean" } }
    },
    "evidenceClass": { "const": "descriptor_and_digest_supplied_not_source_bytes_observed" },
    "hostMutationAllowed": { "const": false },
    "status": { "enum": ["ready", "needs_input", "conflict"] },
    "issues": { "$ref": "#/$defs/issues" },
    "manifestDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "issues": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "pages": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
    "pageRange": { "type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": { "start": { "type": "integer", "minimum": 1 }, "end": { "type": "integer", "minimum": 1 } } },
    "quality": { "type": "object", "additionalProperties": false, "required": ["blur", "cropRisk", "gutterRisk"], "properties": { "blur": { "enum": ["none", "low", "medium", "high", "unknown"] }, "cropRisk": { "enum": ["none", "low", "medium", "high", "unknown"] }, "gutterRisk": { "enum": ["none", "low", "medium", "high", "unknown"] } } },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourceRef", "sequence", "declaredByteLength", "suppliedSha256", "sourceType", "orientation", "pageBasis", "pageIdentityConfirmed", "quality", "primary", "bindingEvidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "sourceRef": { "type": "string", "minLength": 1 }, "sequence": { "type": ["integer", "null"], "minimum": 0 },
        "declaredByteLength": { "type": "integer", "minimum": 0 }, "suppliedSha256": { "$ref": "#/$defs/sha256" },
        "sourceType": { "enum": ["single_page", "spread", "pdf_page", "other"] }, "orientation": { "enum": [0, 90, 180, 270] },
        "pageBasis": { "enum": ["explicit", "page_header", "file_sequence", "inferred_offset"] }, "pageIdentityConfirmed": { "type": "boolean" },
        "quality": { "$ref": "#/$defs/quality" }, "primary": { "type": "boolean" }, "bindingEvidence": { "const": "digest_supplied_not_observed" }
      }
    },
    "page": { "type": "object", "additionalProperties": false, "required": ["page", "primarySourceId", "sources"], "properties": { "page": { "type": "integer", "minimum": 1 }, "primarySourceId": { "type": ["string", "null"] }, "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } } } }
  }
}
